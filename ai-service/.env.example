# VisionBridge AI & Computer Vision Service Configuration
HOST=127.0.0.1
PORT=8001
ENVIRONMENT=development
LOG_LEVEL=info
CORS_ORIGINS=["http://localhost:5000","http://127.0.0.1:5000","http://localhost:5173"]

# Image Validation Limits
