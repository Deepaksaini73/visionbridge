# ==========================================
# VisionBridge Environment Variables Template
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or local fallback)
MONGODB_URI=mongodb://localhost:27017/visionbridge

# JWT Authentication
JWT_SECRET=visionbridge_super_secure_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# Google Gemini AI API (Kept strictly on backend - never expose in client)
GEMINI_API_KEY=your_gemini_api_key_here

# Python AI & Computer Vision Microservice (Port 8001)
AI_SERVICE_URL=http://127.0.0.1:8001

# Application Metadata
APP_NAME=VisionBridge
APP_VERSION=1.0.0

